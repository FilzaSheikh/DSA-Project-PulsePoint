#include <iostream>
#include <string>
#include <fstream>
#include <sstream>
#include <limits>
#include <cstdlib>
using namespace std;

const int DEPARTMENT_COUNT = 4;
const int ROOM_COUNT = 5;
const int LOCATION_COUNT = 6;
const int INF = 99999;

string departmentNames[DEPARTMENT_COUNT] = {
    "General Medicine",
    "Cardiology",
    "Neurology",
    "Orthopedics"
};

string locationNames[LOCATION_COUNT] = {
    "Emergency",
    "General Medicine",
    "Cardiology",
    "Neurology",
    "Orthopedics",
    "Laboratory"
};

class Patient {
public:
    int id;
    string name;
    int age;
    int priority;
    int arrivalNumber;
    int arrivalTime;
    int treatmentTime;
    int dischargeTime;
    int department;
    int roomNumber;
    string status;
    Patient* nextRecord;
};

class BSTNode {
public:
    Patient* patient;
    BSTNode* left;
    BSTNode* right;
};

class QueueNode {
public:
    Patient* patient;
    QueueNode* next;
};

class DepartmentQueue {
public:
    QueueNode* front;
    QueueNode* rear;
};

class StackNode {
public:
    int patientID;
    string action;
    int oldPriority;
    int newPriority;
    StackNode* next;
};

class RoomQueue {
public:
    int rooms[ROOM_COUNT];
    int front;
    int rear;
    int count;
};

Patient* recordsHead = NULL;
BSTNode* bstRoot = NULL;
Patient** triageHeap = NULL;
int heapSize = 0;
int heapCapacity = 5;
DepartmentQueue departmentQueues[DEPARTMENT_COUNT];
StackNode* historyTop = NULL;
RoomQueue roomQueue;
int arrivalCounter = 1;
int systemTime = 0;

int readInt(string message, int low, int high) {
    int value;

    while (true) {
        cout << message;
        cin >> value;

        if (!cin.fail() && value >= low && value <= high) {
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            return value;
        }

        cout << "Invalid input. Enter a number between " << low << " and " << high << ".\n";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
    }
}

string readLine(string message) {
    string value;

    while (true) {
        cout << message;
        getline(cin, value);

        if (!value.empty())
            return value;

        cout << "Input cannot be empty.\n";
    }
}

string priorityName(int priority) {
    if (priority == 1) return "Critical";
    if (priority == 2) return "Emergency";
    if (priority == 3) return "Urgent";
    if (priority == 4) return "Less Urgent";
    return "Non-Urgent";
}

string departmentName(int department) {
    if (department >= 0 && department < DEPARTMENT_COUNT)
        return departmentNames[department];

    return "Unknown";
}

Patient* searchPatient(int id);
void saveData();

void initializeDepartments() {
    for (int i = 0; i < DEPARTMENT_COUNT; i++) {
        departmentQueues[i].front = NULL;
        departmentQueues[i].rear = NULL;
    }
}

void initializeHeap() {
    triageHeap = new Patient*[heapCapacity];
    heapSize = 0;
}

void initializeRooms() {
    roomQueue.front = 0;
    roomQueue.rear = ROOM_COUNT - 1;
    roomQueue.count = ROOM_COUNT;

    for (int i = 0; i < ROOM_COUNT; i++)
        roomQueue.rooms[i] = i + 1;
}

void pushHistory(int id, string action, int oldPriority = -1, int newPriority = -1) {
    StackNode* node = new StackNode;

    node->patientID = id;
    node->action = action;
    node->oldPriority = oldPriority;
    node->newPriority = newPriority;
    node->next = historyTop;

    historyTop = node;
}

void displayHistory() {
    if (historyTop == NULL) {
        cout << "\nNo action history available.\n";
        return;
    }

    StackNode* current = historyTop;

    cout << "\n========== ACTION HISTORY ==========\n";

    while (current != NULL) {
        cout << "Action: " << current->action << "\n";
        cout << "Patient ID: " << current->patientID << "\n";

        if (current->action == "Priority Updated") {
            cout << "Old Priority: " << priorityName(current->oldPriority) << "\n";
            cout << "New Priority: " << priorityName(current->newPriority) << "\n";
        }

        cout << "--------------------------\n";
        current = current->next;
    }
}
void insertBST(Patient* patient) {
    BSTNode* node = new BSTNode;

    node->patient = patient;
    node->left = NULL;
    node->right = NULL;

    if (bstRoot == NULL) {
        bstRoot = node;
        return;
    }

    BSTNode* current = bstRoot;
    BSTNode* parent = NULL;

    while (current != NULL) {
        parent = current;

        if (patient->id < current->patient->id)
            current = current->left;
        else
            current = current->right;
    }

    if (patient->id < parent->patient->id)
        parent->left = node;
    else
        parent->right = node;
}

Patient* searchBST(int id) {
    BSTNode* current = bstRoot;

    while (current != NULL) {
        if (current->patient->id == id)
            return current->patient;

        if (id < current->patient->id)
            current = current->left;
        else
            current = current->right;
    }

    return NULL;
}

Patient* searchPatient(int id) {
    return searchBST(id);
}

BSTNode* minimumBST(BSTNode* root) {
    BSTNode* current = root;

    while (current != NULL && current->left != NULL)
        current = current->left;

    return current;
}

BSTNode* deleteBST(BSTNode* root, int id) {
    if (root == NULL)
        return NULL;

    if (id < root->patient->id) {
        root->left = deleteBST(root->left, id);
    }
    else if (id > root->patient->id) {
        root->right = deleteBST(root->right, id);
    }
    else {
        if (root->left == NULL) {
            BSTNode* temp = root->right;
            delete root;
            return temp;
        }

        if (root->right == NULL) {
            BSTNode* temp = root->left;
            delete root;
            return temp;
        }

        BSTNode* successor = minimumBST(root->right);
        root->patient = successor->patient;
        root->right = deleteBST(root->right, successor->patient->id);
    }

    return root;
}

void displayBSTInOrder(BSTNode* root) {
    if (root == NULL)
        return;

    displayBSTInOrder(root->left);
    cout << root->patient->id << " - " << root->patient->name << "\n";
    displayBSTInOrder(root->right);
}

void addRecord(Patient* patient) {
    if (recordsHead == NULL) {
        recordsHead = patient;
    }
    else {
        Patient* current = recordsHead;

        while (current->nextRecord != NULL)
            current = current->nextRecord;

        current->nextRecord = patient;
    }

    insertBST(patient);
}

bool higherPriority(Patient* a, Patient* b) {
    if (a->priority != b->priority)
        return a->priority < b->priority;

    return a->arrivalNumber < b->arrivalNumber;
}

void swapHeapPatients(Patient*& a, Patient*& b) {
    Patient* temp = a;
    a = b;
    b = temp;
}

void resizeHeap() {
    heapCapacity *= 2;

    Patient** newHeap = new Patient*[heapCapacity];

    for (int i = 0; i < heapSize; i++)
        newHeap[i] = triageHeap[i];

    delete[] triageHeap;
    triageHeap = newHeap;
}

void heapifyUp(int index) {
    while (index > 0) {
        int parent = (index - 1) / 2;

        if (higherPriority(triageHeap[index], triageHeap[parent])) {
            swapHeapPatients(triageHeap[index], triageHeap[parent]);
            index = parent;
        }
        else {
            break;
        }
    }
}

void heapifyDown(int index) {
    while (true) {
        int left = 2 * index + 1;
        int right = 2 * index + 2;
        int best = index;

        if (left < heapSize && higherPriority(triageHeap[left], triageHeap[best]))
            best = left;

        if (right < heapSize && higherPriority(triageHeap[right], triageHeap[best]))
            best = right;

        if (best == index)
            break;

        swapHeapPatients(triageHeap[index], triageHeap[best]);
        index = best;
    }
}

void insertHeap(Patient* patient) {
    if (heapSize == heapCapacity)
        resizeHeap();

    triageHeap[heapSize] = patient;
    heapifyUp(heapSize);
    heapSize++;
}

Patient* extractHeap() {
    if (heapSize == 0)
        return NULL;

    Patient* patient = triageHeap[0];
    heapSize--;

    if (heapSize > 0) {
        triageHeap[0] = triageHeap[heapSize];
        heapifyDown(0);
    }

    return patient;
}

void rebuildHeap() {
    heapSize = 0;

    Patient* current = recordsHead;

    while (current != NULL) {
        if (current->status == "Waiting for Triage")
            insertHeap(current);

        current = current->nextRecord;
    }
}
void enqueueDepartment(int department, Patient* patient) {
    QueueNode* node = new QueueNode;

    node->patient = patient;
    node->next = NULL;

    if (departmentQueues[department].rear == NULL) {
        departmentQueues[department].front = node;
        departmentQueues[department].rear = node;
    }
    else {
        departmentQueues[department].rear->next = node;
        departmentQueues[department].rear = node;
    }
}

Patient* dequeueDepartment(int department) {
    if (departmentQueues[department].front == NULL)
        return NULL;

    QueueNode* temp = departmentQueues[department].front;
    Patient* patient = temp->patient;

    departmentQueues[department].front = temp->next;

    if (departmentQueues[department].front == NULL)
        departmentQueues[department].rear = NULL;

    delete temp;
    return patient;
}

void clearDepartmentQueues() {
    for (int i = 0; i < DEPARTMENT_COUNT; i++) {
        while (departmentQueues[i].front != NULL) {
            QueueNode* temp = departmentQueues[i].front;
            departmentQueues[i].front = temp->next;
            delete temp;
        }

        departmentQueues[i].rear = NULL;
    }
}

bool roomQueueEmpty() {
    return roomQueue.count == 0;
}

bool roomQueueFull() {
    return roomQueue.count == ROOM_COUNT;
}

int allocateRoom() {
    if (roomQueueEmpty())
        return -1;

    int room = roomQueue.rooms[roomQueue.front];
    roomQueue.front = (roomQueue.front + 1) % ROOM_COUNT;
    roomQueue.count--;

    return room;
}

void releaseRoom(int room) {
    if (room < 1 || room > ROOM_COUNT || roomQueueFull())
        return;

    roomQueue.rear = (roomQueue.rear + 1) % ROOM_COUNT;
    roomQueue.rooms[roomQueue.rear] = room;
    roomQueue.count++;
}

void rebuildRoomQueue() {
    bool occupied[ROOM_COUNT + 1] = {false};

    Patient* current = recordsHead;

    while (current != NULL) {
        if (current->roomNumber >= 1 && current->roomNumber <= ROOM_COUNT &&
            current->status == "Under Treatment")
            occupied[current->roomNumber] = true;

        current = current->nextRecord;
    }

    roomQueue.front = 0;
    roomQueue.rear = -1;
    roomQueue.count = 0;

    for (int room = 1; room <= ROOM_COUNT; room++) {
        if (!occupied[room]) {
            roomQueue.rear = (roomQueue.rear + 1) % ROOM_COUNT;
            roomQueue.rooms[roomQueue.rear] = room;
            roomQueue.count++;
        }
    }
}

void displayPatient(Patient* patient) {
    if (patient == NULL)
        return;

    cout << "\nID: " << patient->id;
    cout << "\nName: " << patient->name;
    cout << "\nAge: " << patient->age;
    cout << "\nPriority: " << patient->priority << " (" << priorityName(patient->priority) << ")";
    cout << "\nDepartment: " << departmentName(patient->department);
    cout << "\nStatus: " << patient->status;
    cout << "\nArrival Number: " << patient->arrivalNumber;
    cout << "\nArrival Time: " << patient->arrivalTime;

    if (patient->treatmentTime != -1)
        cout << "\nTreatment Time: " << patient->treatmentTime;

    if (patient->dischargeTime != -1)
        cout << "\nDischarge Time: " << patient->dischargeTime;

    if (patient->roomNumber != -1)
        cout << "\nRoom Number: " << patient->roomNumber;

    cout << "\n";
}
void registerPatient() {
    int id = readInt("\nEnter Patient ID: ", 1, 999999);

    if (searchPatient(id) != NULL) {
        cout << "Patient ID already exists.\n";
        return;
    }

    string name = readLine("Enter Patient Name: ");
    int age = readInt("Enter Patient Age: ", 1, 120);

    cout << "\n1. Critical\n";
    cout << "2. Emergency\n";
    cout << "3. Urgent\n";
    cout << "4. Less Urgent\n";
    cout << "5. Non-Urgent\n";

    int priority = readInt("Select Priority: ", 1, 5);

    cout << "\nSelect Department:\n";

    for (int i = 0; i < DEPARTMENT_COUNT; i++)
        cout << i + 1 << ". " << departmentNames[i] << "\n";

    int department = readInt("Enter Department: ", 1, DEPARTMENT_COUNT) - 1;

    Patient* patient = new Patient;

    patient->id = id;
    patient->name = name;
    patient->age = age;
    patient->priority = priority;
    patient->arrivalNumber = arrivalCounter++;
    patient->arrivalTime = systemTime++;
    patient->treatmentTime = -1;
    patient->dischargeTime = -1;
    patient->department = department;
    patient->roomNumber = -1;
    patient->status = "Waiting for Triage";
    patient->nextRecord = NULL;

    addRecord(patient);
    insertHeap(patient);
    pushHistory(id, "Patient Registered");
    saveData();

    cout << "\nPatient registered successfully.\n";
}

void displayAllPatients() {
    if (recordsHead == NULL) {
        cout << "\nNo patient records found.\n";
        return;
    }

    Patient* current = recordsHead;

    cout << "\n========== ALL PATIENTS ==========\n";

    while (current != NULL) {
        displayPatient(current);
        current = current->nextRecord;
    }
}

void displayTriageHeap() {
    if (heapSize == 0) {
        cout << "\nNo patients waiting for triage.\n";
        return;
    }

    cout << "\n========== EMERGENCY PRIORITY HEAP ==========\n";

    for (int i = 0; i < heapSize; i++) {
        cout << "\nHeap Position " << i + 1 << ":";
        displayPatient(triageHeap[i]);
    }
}

void callNextPatient() {
    Patient* patient = extractHeap();

    if (patient == NULL) {
        cout << "\nNo patients are waiting for triage.\n";
        return;
    }

    patient->status = "Waiting for Department";
    enqueueDepartment(patient->department, patient);
    pushHistory(patient->id, "Patient Sent to Department");
    saveData();

    cout << "\nPatient moved to department queue.\n";
    displayPatient(patient);
}

void updatePriority() {
    int id = readInt("\nEnter Patient ID: ", 1, 999999);
    Patient* patient = searchPatient(id);

    if (patient == NULL) {
        cout << "Patient not found.\n";
        return;
    }

    if (patient->status != "Waiting for Triage") {
        cout << "Only patients waiting for triage can change priority.\n";
        return;
    }

    int newPriority = readInt("Enter New Priority (1-5): ", 1, 5);
    int oldPriority = patient->priority;

    if (newPriority == oldPriority) {
        cout << "Priority is already set to this level.\n";
        return;
    }

    patient->priority = newPriority;
    rebuildHeap();
    pushHistory(id, "Priority Updated", oldPriority, newPriority);
    saveData();

    cout << "Priority updated successfully.\n";
}

void undoPriorityUpdate() {
    if (historyTop == NULL) {
        cout << "\nNo action available to undo.\n";
        return;
    }

    StackNode* current = historyTop;

    while (current != NULL && current->action != "Priority Updated")
        current = current->next;

    if (current == NULL) {
        cout << "\nNo priority update available to undo.\n";
        return;
    }

    Patient* patient = searchPatient(current->patientID);

    if (patient == NULL || patient->status != "Waiting for Triage") {
        cout << "\nThe priority update can no longer be undone.\n";
        return;
    }

    patient->priority = current->oldPriority;
    rebuildHeap();

    StackNode* previous = NULL;
    StackNode* node = historyTop;

    while (node != current) {
        previous = node;
        node = node->next;
    }

    if (previous == NULL)
        historyTop = current->next;
    else
        previous->next = current->next;

    delete current;

    pushHistory(patient->id, "Priority Update Undone");
    saveData();

    cout << "\nPriority update undone successfully.\n";
}

void searchByID() {
    int id = readInt("\nEnter Patient ID: ", 1, 999999);
    Patient* patient = searchPatient(id);

    if (patient == NULL)
        cout << "\nPatient not found.\n";
    else
        displayPatient(patient);
}

string lowerText(string text) {
    for (int i = 0; i < (int)text.length(); i++) {
        if (text[i] >= 'A' && text[i] <= 'Z')
            text[i] = char(text[i] + 32);
    }

    return text;
}

void searchByName() {
    string name = readLine("\nEnter patient name or part of name: ");
    string target = lowerText(name);
    Patient* current = recordsHead;
    bool found = false;

    while (current != NULL) {
        if (lowerText(current->name).find(target) != string::npos) {
            displayPatient(current);
            found = true;
        }

        current = current->nextRecord;
    }

    if (!found)
        cout << "\nNo matching patient found.\n";
}

void editPatient() {
    int id = readInt("\nEnter Patient ID: ", 1, 999999);
    Patient* patient = searchPatient(id);

    if (patient == NULL) {
        cout << "Patient not found.\n";
        return;
    }

    cout << "\n1. Edit Name\n";
    cout << "2. Edit Age\n";
    cout << "3. Change Department\n";

    int choice = readInt("Enter Choice: ", 1, 3);

    if (choice == 1) {
        patient->name = readLine("Enter New Name: ");
    }
    else if (choice == 2) {
        patient->age = readInt("Enter New Age: ", 1, 120);
    }
    else {
        if (patient->status != "Waiting for Triage") {
            cout << "Department can only be changed before triage.\n";
            return;
        }

        for (int i = 0; i < DEPARTMENT_COUNT; i++)
            cout << i + 1 << ". " << departmentNames[i] << "\n";

        patient->department = readInt("Enter Department: ", 1, DEPARTMENT_COUNT) - 1;
    }

    pushHistory(id, "Patient Record Edited");
    saveData();

    cout << "\nPatient record updated successfully.\n";
}

void deletePatient() {
    int id = readInt("\nEnter Patient ID: ", 1, 999999);
    Patient* patient = searchPatient(id);

    if (patient == NULL) {
        cout << "Patient not found.\n";
        return;
    }

    if (patient->status != "Discharged") {
        cout << "Only discharged patients can be deleted.\n";
        return;
    }

    Patient* current = recordsHead;
    Patient* previous = NULL;

    while (current != NULL && current != patient) {
        previous = current;
        current = current->nextRecord;
    }

    if (previous == NULL)
        recordsHead = current->nextRecord;
    else
        previous->nextRecord = current->nextRecord;

    bstRoot = deleteBST(bstRoot, id);

    delete patient;

    pushHistory(id, "Patient Record Deleted");
    saveData();

    cout << "\nPatient record deleted successfully.\n";
}
void displayDepartmentQueues() {
    cout << "\n========== DEPARTMENT QUEUES ==========\n";

    for (int i = 0; i < DEPARTMENT_COUNT; i++) {
        cout << "\n" << departmentNames[i] << ":\n";

        QueueNode* current = departmentQueues[i].front;

        if (current == NULL) {
            cout << "No patients waiting.\n";
            continue;
        }

        while (current != NULL) {
            cout << "ID: " << current->patient->id
                 << " | Name: " << current->patient->name << "\n";
            current = current->next;
        }
    }
}

void serveDepartmentPatient() {
    cout << "\nSelect Department:\n";

    for (int i = 0; i < DEPARTMENT_COUNT; i++)
        cout << i + 1 << ". " << departmentNames[i] << "\n";

    int department = readInt("Enter Department: ", 1, DEPARTMENT_COUNT) - 1;

    if (roomQueueEmpty()) {
        cout << "\nAll treatment rooms are currently occupied.\n";
        return;
    }

    Patient* patient = dequeueDepartment(department);

    if (patient == NULL) {
        cout << "\nNo patients waiting in this department.\n";
        return;
    }

    int room = allocateRoom();

    patient->roomNumber = room;
    patient->status = "Under Treatment";
    patient->treatmentTime = systemTime++;

    pushHistory(patient->id, "Treatment Started");
    saveData();

    cout << "\nPatient assigned to Room " << room << ".\n";
    displayPatient(patient);
}

void dischargePatient() {
    int id = readInt("\nEnter Patient ID: ", 1, 999999);
    Patient* patient = searchPatient(id);

    if (patient == NULL) {
        cout << "Patient not found.\n";
        return;
    }

    if (patient->status != "Under Treatment") {
        cout << "Patient must be under treatment before discharge.\n";
        return;
    }

    int room = patient->roomNumber;

    patient->roomNumber = -1;
    patient->status = "Discharged";
    patient->dischargeTime = systemTime++;

    releaseRoom(room);
    pushHistory(id, "Patient Discharged");
    saveData();

    cout << "\nPatient discharged successfully.\n";
    cout << "Room " << room << " is now available.\n";
}

void displayRooms() {
    cout << "\n========== TREATMENT ROOMS ==========\n";

    cout << "Available Rooms: ";

    if (roomQueueEmpty()) {
        cout << "None";
    }
    else {
        for (int i = 0; i < roomQueue.count; i++) {
            int index = (roomQueue.front + i) % ROOM_COUNT;
            cout << roomQueue.rooms[index] << " ";
        }
    }

    cout << "\n\nOccupied Rooms:\n";

    bool found = false;
    Patient* current = recordsHead;

    while (current != NULL) {
        if (current->roomNumber != -1) {
            cout << "Room " << current->roomNumber
                 << " - " << current->name << "\n";
            found = true;
        }

        current = current->nextRecord;
    }

    if (!found)
        cout << "No occupied rooms.\n";
}

void displayBST() {
    if (bstRoot == NULL) {
        cout << "\nPatient ID BST is empty.\n";
        return;
    }

    cout << "\n========== PATIENT ID BST ==========\n";
    displayBSTInOrder(bstRoot);
}

void insertionSortByAge(Patient** array, int count, long long& comparisons) {
    for (int i = 1; i < count; i++) {
        Patient* key = array[i];
        int j = i - 1;

        while (j >= 0) {
            comparisons++;

            if (array[j]->age > key->age) {
                array[j + 1] = array[j];
                j--;
            }
            else {
                break;
            }
        }

        array[j + 1] = key;
    }
}

void mergePatients(Patient** array, Patient** temp, int left, int mid, int right, long long& comparisons) {
    int i = left;
    int j = mid + 1;
    int k = left;

    while (i <= mid && j <= right) {
        comparisons++;

        if (array[i]->id <= array[j]->id)
            temp[k++] = array[i++];
        else
            temp[k++] = array[j++];
    }

    while (i <= mid)
        temp[k++] = array[i++];

    while (j <= right)
        temp[k++] = array[j++];

    for (int x = left; x <= right; x++)
        array[x] = temp[x];
}

void mergeSortByID(Patient** array, Patient** temp, int left, int right, long long& comparisons) {
    if (left >= right)
        return;

    int mid = left + (right - left) / 2;

    mergeSortByID(array, temp, left, mid, comparisons);
    mergeSortByID(array, temp, mid + 1, right, comparisons);
    mergePatients(array, temp, left, mid, right, comparisons);
}
void sortingMenu() {
    int count = 0;
    Patient* current = recordsHead;

    while (current != NULL) {
        count++;
        current = current->nextRecord;
    }

    if (count == 0) {
        cout << "\nNo records to sort.\n";
        return;
    }

    Patient** array = new Patient*[count];
    current = recordsHead;

    for (int i = 0; i < count; i++) {
        array[i] = current;
        current = current->nextRecord;
    }

    cout << "\n1. Insertion Sort by Age\n";
    cout << "2. Merge Sort by Patient ID\n";

    int choice = readInt("Enter Choice: ", 1, 2);
    long long comparisons = 0;

    if (choice == 1) {
        insertionSortByAge(array, count, comparisons);
        cout << "\n========== SORTED BY AGE ==========\n";
    }
    else {
        Patient** temp = new Patient*[count];
        mergeSortByID(array, temp, 0, count - 1, comparisons);
        delete[] temp;
        cout << "\n========== SORTED BY PATIENT ID ==========\n";
    }

    for (int i = 0; i < count; i++)
        displayPatient(array[i]);

    cout << "Number of comparisons: " << comparisons << "\n";

    delete[] array;
}

void displayStatistics() {
    int total = 0;
    int triage = 0;
    int departmentWaiting = 0;
    int treatment = 0;
    int discharged = 0;

    Patient* current = recordsHead;

    while (current != NULL) {
        total++;

        if (current->status == "Waiting for Triage")
            triage++;
        else if (current->status == "Waiting for Department")
            departmentWaiting++;
        else if (current->status == "Under Treatment")
            treatment++;
        else if (current->status == "Discharged")
            discharged++;

        current = current->nextRecord;
    }

    cout << "\n========== PULSEPOINT STATISTICS ==========\n";
    cout << "Total Registered Patients: " << total << "\n";
    cout << "Waiting for Triage: " << triage << "\n";
    cout << "Waiting for Department: " << departmentWaiting << "\n";
    cout << "Under Treatment: " << treatment << "\n";
    cout << "Discharged: " << discharged << "\n";
    cout << "Available Treatment Rooms: " << roomQueue.count << "\n";

    cout << "\nDepartment Counts:\n";

    for (int i = 0; i < DEPARTMENT_COUNT; i++) {
        int count = 0;
        current = recordsHead;

        while (current != NULL) {
            if (current->department == i)
                count++;

            current = current->nextRecord;
        }

        cout << departmentNames[i] << ": " << count << "\n";
    }
}

void findHospitalRoute() {
    int graph[LOCATION_COUNT][LOCATION_COUNT] = {
        {0, 4, 3, 7, 6, 5},
        {4, 0, 4, INF, 5, 3},
        {3, 4, 0, 2, INF, 4},
        {7, INF, 2, 0, 3, 5},
        {6, 5, INF, 3, 0, 4},
        {5, 3, 4, 5, 4, 0}
    };

    cout << "\n========== HOSPITAL LOCATIONS ==========\n";

    for (int i = 1; i < LOCATION_COUNT; i++)
        cout << i << ". " << locationNames[i] << "\n";

    int destination = readInt("Select Destination: ", 1, LOCATION_COUNT - 1);

    int distance[LOCATION_COUNT];
    int previous[LOCATION_COUNT];
    bool visited[LOCATION_COUNT] = {false};

    for (int i = 0; i < LOCATION_COUNT; i++) {
        distance[i] = INF;
        previous[i] = -1;
    }

    distance[0] = 0;

    for (int count = 0; count < LOCATION_COUNT; count++) {
        int current = -1;

        for (int i = 0; i < LOCATION_COUNT; i++) {
            if (!visited[i] &&
                (current == -1 || distance[i] < distance[current]))
                current = i;
        }

        if (current == -1 || distance[current] == INF)
            break;

        visited[current] = true;

        for (int i = 0; i < LOCATION_COUNT; i++) {
            if (!visited[i] &&
                graph[current][i] != INF &&
                distance[current] + graph[current][i] < distance[i]) {
                distance[i] = distance[current] + graph[current][i];
                previous[i] = current;
            }
        }
    }

    int path[LOCATION_COUNT];
    int pathSize = 0;
    int current = destination;

    while (current != -1) {
        path[pathSize++] = current;
        current = previous[current];
    }

    cout << "\nShortest Route:\n";

    for (int i = pathSize - 1; i >= 0; i--) {
        cout << locationNames[path[i]];

        if (i > 0)
            cout << " -> ";
    }

    cout << "\nTotal Distance: " << distance[destination] << " units\n";
}
void saveData() {
    ofstream file("patients.txt");

    if (!file)
        return;

    Patient* current = recordsHead;

    while (current != NULL) {
        file << current->id << "|"
             << current->name << "|"
             << current->age << "|"
             << current->priority << "|"
             << current->arrivalNumber << "|"
             << current->arrivalTime << "|"
             << current->treatmentTime << "|"
             << current->dischargeTime << "|"
             << current->department << "|"
             << current->roomNumber << "|"
             << current->status << "\n";

        current = current->nextRecord;
    }

    file.close();
}

void loadData() {
    ifstream file("patients.txt");

    if (!file)
        return;

    string line;

    while (getline(file, line)) {
        stringstream ss(line);
        string values[11];
        bool valid = true;

        for (int i = 0; i < 11; i++) {
            if (i == 10) {
                if (!getline(ss, values[i]))
                    valid = false;
            }
            else if (!getline(ss, values[i], '|')) {
                valid = false;
            }
        }

        if (!valid)
            continue;

        try {
            Patient* patient = new Patient;

            patient->id = atoi(values[0].c_str());
            patient->name = values[1];
            patient->age = atoi(values[2].c_str());
            patient->priority = atoi(values[3].c_str());
            patient->arrivalNumber = atoi(values[4].c_str());
            patient->arrivalTime = atoi(values[5].c_str());
            patient->treatmentTime = atoi(values[6].c_str());
            patient->dischargeTime = atoi(values[7].c_str());
            patient->department = atoi(values[8].c_str());
            patient->roomNumber = atoi(values[9].c_str());
            patient->status = values[10];
            patient->nextRecord = NULL;

            if (patient->id <= 0 ||
                patient->age <= 0 ||
                patient->priority < 1 ||
                patient->priority > 5 ||
                patient->department < 0 ||
                patient->department >= DEPARTMENT_COUNT ||
                patient->roomNumber < -1 ||
                patient->roomNumber > ROOM_COUNT) {
                delete patient;
                continue;
            }

            if (searchPatient(patient->id) != NULL) {
                delete patient;
                continue;
            }

            addRecord(patient);

            if (patient->status == "Waiting for Triage")
                insertHeap(patient);
            else if (patient->status == "Waiting for Department")
                enqueueDepartment(patient->department, patient);

            if (patient->arrivalNumber >= arrivalCounter)
                arrivalCounter = patient->arrivalNumber + 1;

            if (patient->arrivalTime >= systemTime)
                systemTime = patient->arrivalTime + 1;

            if (patient->treatmentTime >= systemTime)
                systemTime = patient->treatmentTime + 1;

            if (patient->dischargeTime >= systemTime)
                systemTime = patient->dischargeTime + 1;
        }
        catch (...) {
            continue;
        }
    }

    file.close();
    rebuildRoomQueue();
}

void cleanupBST(BSTNode* root) {
    if (root == NULL)
        return;

    cleanupBST(root->left);
    cleanupBST(root->right);
    delete root;
}

void finalCleanup() {
    saveData();
    clearDepartmentQueues();

    while (historyTop != NULL) {
        StackNode* temp = historyTop;
        historyTop = historyTop->next;
        delete temp;
    }

    cleanupBST(bstRoot);
    bstRoot = NULL;

    delete[] triageHeap;
    triageHeap = NULL;

    while (recordsHead != NULL) {
        Patient* temp = recordsHead;
        recordsHead = recordsHead->nextRecord;
        delete temp;
    }
}
