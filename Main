}

int main() {
    initializeDepartments();
    initializeHeap();
    initializeRooms();
    loadData();

    int choice;

    do {
        displayMenu();
        choice = readInt("\nEnter your choice: ", 1, 21);

        switch (choice) {
            case 1:
                registerPatient();
                break;
            case 2:
                displayAllPatients();
                break;
            case 3:
                displayTriageHeap();
                break;
            case 4:
                callNextPatient();
                break;
            case 5:
                updatePriority();
                break;
            case 6:
                undoPriorityUpdate();
                break;
            case 7:
                searchByID();
                break;
            case 8:
                searchByName();
                break;
            case 9:
                editPatient();
                break;
            case 10:
                deletePatient();
                break;
            case 11:
                displayDepartmentQueues();
                break;
            case 12:
                serveDepartmentPatient();
                break;
            case 13:
                dischargePatient();
                break;
            case 14:
                displayRooms();
                break;
            case 15:
                displayBST();
                break;
            case 16:
                sortingMenu();
                break;
            case 17:
                displayStatistics();
                break;
            case 18:
                findHospitalRoute();
                break;
            case 19:
                displayHistory();
                break;
            case 20:
                saveData();
                cout << "\nRecords saved successfully.\n";
                break;
            case 21:
                finalCleanup();
                cout << "\nThank you for using PulsePoint!\n";
                break;
        }
    } while (choice != 21);

    return 0;
}

