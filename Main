    cout << "12. Serve Next Department Patient\n";
    cout << "13. Discharge Patient\n";
    cout << "14. View Treatment Rooms\n";
    cout << "15. View Patient ID BST\n";
    cout << "16. Sort Patient Records\n";
    cout << "17. View Statistics\n";
    cout << "18. Find Shortest Hospital Route\n";
    cout << "19. View Action History\n";
    cout << "20. Save Records\n";
